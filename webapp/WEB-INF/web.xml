<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE web-app PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN" "http://java.sun.com/dtd/web-app_2_3.dtd">
<web-app>
  <display-name>Polarion AI Assistant</display-name>
  <filter>
    <filter-name>polarionDoAs</filter-name>
    <filter-class>com.polarion.portal.tomcat.servlets.DoAsFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>polarionDoAs</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <servlet><servlet-name>assistantChat</servlet-name><servlet-class>com.zaamtech.polarion.aiassistant.web.ChatServlet</servlet-class></servlet>
  <servlet><servlet-name>assistantAdmin</servlet-name><servlet-class>com.zaamtech.polarion.aiassistant.web.AdminServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>assistantChat</servlet-name><url-pattern>/api/chat</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>assistantChat</servlet-name><url-pattern>/api/config</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>assistantAdmin</servlet-name><url-pattern>/admin</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>assistantAdmin</servlet-name><url-pattern>/api/admin/*</url-pattern></servlet-mapping>
  <security-constraint><web-resource-collection><web-resource-name>Authenticated assistant API</web-resource-name><url-pattern>/api/chat</url-pattern><url-pattern>/api/config</url-pattern></web-resource-collection><auth-constraint><role-name>user</role-name><role-name>admin</role-name></auth-constraint></security-constraint>
  <security-constraint><web-resource-collection><web-resource-name>Arctic AI administration</web-resource-name><url-pattern>/admin</url-pattern><url-pattern>/api/admin/*</url-pattern></web-resource-collection><auth-constraint><role-name>admin</role-name></auth-constraint></security-constraint>
  <login-config><auth-method>FORM</auth-method><realm-name>PolarionRealm</realm-name><form-login-config><form-login-page>/login/login</form-login-page><form-error-page>/login/error</form-error-page></form-login-config></login-config>
  <security-role><role-name>user</role-name></security-role>
  <security-role><role-name>admin</role-name></security-role>
</web-app>
